<?xml version="1.0" encoding="utf-8"?>
<!--
  Không đặt background ở đây: theme đã vẽ windowBackground (splash cùng màu
  zgo_blue). Thêm nền nữa là overdraw — hệ thống tô hai lớp cho cùng một pixel,
  và trong lúc WebView còn trắng sẽ thấy một khung xám chớp qua.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
