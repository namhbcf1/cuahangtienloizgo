{
  "name": "smartpos-simple",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:features": "node qa_verify_features.mjs",
    "verify:api": "node scripts/verify.mjs --api",
    "verify:ui": "node scripts/verify.mjs --ui",
    "verify:responsive": "node scripts/verify.mjs --responsive",
    "test": "npm run typecheck && npm run verify",
    "apk": "node scripts/build-apk.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name cuahangtienloizgo --branch main --commit-dirty=true"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260124.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "hono": "^4.11.5",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
